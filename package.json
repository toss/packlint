{
  "name": "packlint-monorepo",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@packlint/core": "workspace:^",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "packlint": "workspace:^",
    "prettier": "^3.7.4",
    "turbo": "^2.8.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  }
}
